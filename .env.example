# =============================================================================
# Environment variables for the investing toolkit (Daloopa-free fork)
# Copy to `.env` and fill in. None are strictly required to start.
# =============================================================================

# SEC EDGAR requires a User-Agent identifying you for any programmatic access.
# Format: "Your Name your.email@example.com" (or company + contact email).
# Without this, free_data.py will use a generic placeholder which may get
# rate-limited or blocked. Set this to something real.
SEC_USER_AGENT=Your Name your.email@example.com

# Optional: FRED API key for risk-free rate in DCF/WACC calculations.
# Free key at https://fred.stlouisfed.org/docs/api/api_key.html
# Without this, DCF defaults to a 4.5% risk-free rate.
FRED_API_KEY=

# Optional: Alpha Vantage API key (free tier, 25 calls/day).
# Useful as a fallback if yfinance returns empty for a ticker.
# Sign up at https://www.alphavantage.co/support/#api-key
ALPHAVANTAGE_API_KEY=

# Optional: Financial Modeling Prep API key (free tier, 250 calls/day).
# Provides additional consensus estimates and ratios that yfinance lacks.
# Sign up at https://site.financialmodelingprep.com/developer/docs
FMP_API_KEY=
